# app
NEXT_PUBLIC_APP_URL = "http://localhost:3000"
NEXT_PUBLIC_APP_NAME = "SOP2Workflow"
NEXT_PUBLIC_APP_DESCRIPTION = "Turn ERP SOPs into n8n-ready automation workflows."
NEXT_PUBLIC_APP_LOGO = "/logo.svg"
NEXT_PUBLIC_APP_FAVICON = "/favicon.svg"

# theme
NEXT_PUBLIC_THEME = "default"

# appearance
NEXT_PUBLIC_APPEARANCE = "dark"

# database
DATABASE_PROVIDER = "postgresql"
DATABASE_URL = ""
DB_SINGLETON_ENABLED = "true"
DB_MAX_CONNECTIONS = "1"

# auth secret
# openssl rand -base64 32
AUTH_SECRET = ""

# SOP model analysis (server-only; never prefix the key with NEXT_PUBLIC_)
EVOLINK_API_KEY = ""
EVOLINK_API_URL = "https://direct.evolink.ai/v1/chat/completions"
EVOLINK_MODEL = "gemini-3.8-flash"

# Anonymous quota protection
SOP_WORKFLOW_RATE_SALT = ""
SOP_WORKFLOW_MIN_INTERVAL_MS = "10000"
SOP_WORKFLOW_CLIENT_DAILY_LIMIT = "20"
SOP_WORKFLOW_GLOBAL_DAILY_LIMIT = "200"
